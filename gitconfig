	email = 6400000+jonnyparris@users.noreply.github.com

# Shortcuts for git clone, e.g. `git clone gh:plutov/gitbootstrap`
[url "https://github.com/"]
    insteadOf = gh:
[url "https://gist.github.com/"]
    insteadOf = gist:
[url "https://bitbucket.org/"]
    insteadOf = bb:
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
# Machine-local overrides (work identity, certs). Never committed.
[include]
	path = ~/.gitconfig.local
